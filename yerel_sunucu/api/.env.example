# ====================================================================
# SAHA TAKİP SİSTEMİ - YEREL API SUNUCU YAPILANDIRMASI (.env)
# Bu dosyayı '.env' olarak kaydedip kendi SQL Server bilgilerinizi giriniz.
# ====================================================================

# API Portu
PORT=3000

# Microsoft SQL Server Bağlantı Bilgileri
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SahaTakipDB
DB_USER=sa
DB_PASSWORD=Sifreniz123!

# SQL Server Şifreleme (Yerel sunucuda genelde false)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Fotoğraf Yükleme Klasörü (Windows Server diski)
UPLOAD_DIR=C:\\SahaTakipUploads

# OneSignal Entegrasyonu (Push Bildirimler)
ONESIGNAL_APP_ID=03e50631-8d38-4796-a90f-ae524dab69fd
ONESIGNAL_REST_KEY=BURAYA_ONESIGNAL_REST_KEY_YAZIN
